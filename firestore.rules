rules_version = '2';

// ============================================================
// الدليل الشامل — Firestore Rules (STAGED / NOT DEPLOYED YET)
// ============================================================
// راجع واختبر الملف على Emulator قبل نشره على الإنتاج.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberDoc(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(memberDoc(request.auth.uid))
        && get(memberDoc(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function memberProtectedFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasNone([
        'uid',
        'isAdmin',
        'status',
        'verified',
        'createdAt',
        'subscriptionStart',
        'subscriptionEnd',
        'subscriptionDurationDays',
        'subscriptionRenewedAt',
        'approvedAt',
        'rejectedAt',
        'subscriptionCancelledAt'
      ]);
    }

    function memberEngagementFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasNone([
        'views', 'calls', 'waMessages', 'saves', 'followersCount', 'rating', 'reviews'
      ]);
    }

    function ownPlanChangeAllowed() {
      // العضو يقدر يختار الباقة وهو Pending فقط؛ بعد الاعتماد الإدارة هي اللي تغيّرها.
      return !('status' in resource.data)
        || resource.data.status != 'approved'
        || request.resource.data.plan == resource.data.plan;
    }

    function plusOne(field) {
      return onlyChanged([field])
        && request.resource.data.get(field, -1) is number
        && request.resource.data.get(field, -1) == resource.data.get(field, 0) + 1;
    }

    function plusOrMinusOneNonNegative(field) {
      return onlyChanged([field])
        && request.resource.data.get(field, -1) is number
        && request.resource.data.get(field, -1) >= 0
        && (
          request.resource.data.get(field, -1) == resource.data.get(field, 0) + 1
          || request.resource.data.get(field, -1) == resource.data.get(field, 0) - 1
        );
    }

    function reviewAggregateUpdate() {
      return onlyChanged(['reviews', 'rating'])
        && request.resource.data.get('reviews', -1) == resource.data.get('reviews', 0) + 1
        && request.resource.data.get('rating', 0) is number
        && request.resource.data.get('rating', 0) >= 1
        && request.resource.data.get('rating', 0) <= 5;
    }

    // ----------------------------------------------------------
    // MEMBERS
    // ----------------------------------------------------------
    match /members/{memberId} {
      // الملفات المعتمدة عامة، وصاحب الحساب/الأدمن يقدر يشوف حسابه حتى لو Pending.
      allow get, list: if (resource.data.get('status', '') == 'approved') || self(memberId) || isAdmin();

      // إنشاء الحساب لنفس UID فقط، وممنوع يخلق نفسه Admin/Verified أو يخلق اشتراك معتمد.
      allow create: if self(memberId)
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'verified',
          'approvedAt',
          'rejectedAt',
          'subscriptionStart',
          'subscriptionEnd',
          'subscriptionDurationDays',
          'subscriptionRenewedAt',
          'subscriptionCancelledAt'
        ])
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending');

      // الأدمن يقدر يعدل كل شيء.
      // صاحب الحساب يعدل بياناته العادية فقط، بدون العبث بالحقول الإدارية أو الإحصائيات.
      // عدادات التفاعل المشتركة لها تحديثات محددة جدًا حتى يفضل السلوك الحالي للتطبيق شغال.
      allow update: if isAdmin()
        || (self(memberId)
          && memberProtectedFieldsUnchanged()
          && memberEngagementFieldsUnchanged()
          && ownPlanChangeAllowed())
        // مشاهدة/اتصال/واتساب ممكن يحصلوا من زائر غير مسجل، لكن الزيادة لازم تكون +1 فقط.
        || plusOne('views')
        || plusOne('calls')
        || plusOne('waMessages')
        // الحفظ والمتابعة والتقييم تتطلب مستخدم مسجل.
        || (signedIn() && plusOrMinusOneNonNegative('saves'))
        || (signedIn() && plusOrMinusOneNonNegative('followersCount'))
        || (signedIn() && reviewAggregateUpdate());

      allow delete: if isAdmin();

      // تقييمات العضو
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }

      // المحفوظات — خاصة بصاحب الحساب
      match /saved/{savedMemberId} {
        allow read, create, update, delete: if self(memberId) || isAdmin();
      }

      // المتابعون
      match /followers/{followerId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == followerId
          && request.resource.data.followerId == request.auth.uid;
        allow delete: if (signedIn() && request.auth.uid == followerId) || isAdmin();
        allow update: if false;
      }
    }

    // ----------------------------------------------------------
    // POSTS + COMMENTS
    // ----------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid)
        || (signedIn() && onlyChanged(['likedBy', 'likes']))
        || (signedIn() && onlyChanged(['comments']))
        || (signedIn() && onlyChanged(['shares']));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes']);
        allow delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // ----------------------------------------------------------
    // DIRECT MESSAGES
    // ----------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.users);

      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users;

      // أطراف المحادثة يقدروا يحدثوا آخر رسالة/وقت فقط، لكن ما يغيروش قائمة المشاركين.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.users
          && request.resource.data.users == resource.data.users
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastTime', 'updatedAt']));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId));
        }

        allow read: if isAdmin()
          || (signedIn() && request.auth.uid in parentChat().data.users);

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in parentChat().data.users;

        allow update: if signedIn()
          && request.auth.uid in parentChat().data.users
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if isAdmin();
      }
    }

    // ----------------------------------------------------------
    // QUICK SERVICE REQUESTS
    // ----------------------------------------------------------
    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1500;
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // JOBS
    // ----------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.postedBy == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn() && resource.data.postedBy == request.auth.uid)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants'])
          && request.resource.data.applicants == resource.data.get('applicants', 0) + 1);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.postedBy == request.auth.uid);
    }

    match /jobApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn()
          && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid);

      allow update: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ----------------------------------------------------------
    // NOTIFICATIONS
    // ----------------------------------------------------------
    match /notifications/{notificationId} {
      // الشخص يشوف الإشعارات الموجهة له والإشعارات العامة فقط.
      allow read: if isAdmin()
        || (signedIn()
          && ((resource.data.get('recipientId', null) == request.auth.uid)
            || resource.data.get('recipientId', null) == null));

      // الإشعار العام للأدمن فقط.
      // الإشعار الشخصي مسموح لمستخدم مسجل للتوافق مع الرسائل/المتابعة/زيارة البروفايل الحالية.
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.get('recipientId', null) is string);

      // المستخدم يقدر يعلّم إشعاره كمقروء فقط.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.get('recipientId', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (signedIn()
          && resource.data.get('recipientId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // PAYMENTS / ADS
    // ----------------------------------------------------------
    match /payments/{paymentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // APP CONFIG + SITE STATS
    // ----------------------------------------------------------
    match /config/appSettings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/stats {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['totalVisits'])
        && request.resource.data.totalVisits is number
        && request.resource.data.totalVisits >= 10000;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits'])
        && request.resource.data.totalVisits == resource.data.totalVisits + 1;

      allow delete: if isAdmin();
    }

    // privateConfig/adminAuth وأي Collection غير مذكورة فوق مقفولة تمامًا للعميل.
    // Cloud Functions عبر Admin SDK تتجاوز القواعد دي بأمان.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
