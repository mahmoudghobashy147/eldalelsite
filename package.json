{
  "name": "daleel-shamil-web",
  "version": "2.1.0",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "firebase": "^12.15.0",
    "heic2any": "^0.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "sitemap": "node generate-sitemap.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run sitemap && npm run build",
    "deploy": "gh-pages -d build"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/craftsmen",
      "/companies",
      "/about",
      "/how-it-works",
      "/faq",
      "/privacy",
      "/terms"
    ],
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "skipThirdPartyRequests": true
  },
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "gh-pages": "^6.3.0",
    "react-snap": "^1.23.0"
  }
}