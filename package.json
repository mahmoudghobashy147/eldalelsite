{
  "name": "daleel-shamil-web",
  "version": "2.1.0",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/push-notifications": "^6.0.2",
    "firebase": "^12.15.0",
    "heic2any": "^0.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "patch:safety": "node scripts/apply-safe-patches.js && node scripts/apply-plan-field-patches.js && node scripts/apply-chat-rule-patches.js && node scripts/apply-server-notification-patches.js && node scripts/apply-engagement-counter-patches.js && node scripts/apply-engagement-rule-patches.js && node scripts/apply-review-integrity-patches.js && node scripts/apply-data-integrity-patches.js && node scripts/apply-service-request-security-patches.js && node scripts/apply-member-interaction-security-patches.js && node scripts/add-finishing-catalog.js && node scripts/enhance-finishing-catalog.js",
    "prestart": "npm run patch:safety",
    "start": "react-scripts start",
    "prebuild": "npm run patch:safety",
    "build": "react-scripts build",
    "postbuild": "node scripts/verify-build-output.js && node scripts/verify-catalog-integration.js",
    "sitemap": "node generate-sitemap.js",
    "test": "react-scripts test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-daleel-rules \"node scripts/test-firestore-rules.js\"",
    "test:storage-rules": "node scripts/test-storage-rules.js",
    "test:all-rules": "npm run test:rules && npm run test:storage-rules",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/craftsmen",
      "/companies",
      "/about",
      "/how-it-works",
      "/faq",
      "/privacy",
      "/terms"
    ],
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "skipThirdPartyRequests": true
  },
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.2",
    "gh-pages": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-snap": "^1.23.0"
  }
}
